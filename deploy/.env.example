# Copy this file to .env in the same directory and fill in real values.
# .env is gitignored — never commit it.

# --- Domain & TLS ---
# The domain this instance will be reachable at. Must have a DNS record
# (A/AAAA, or a CNAME through Cloudflare) pointing at this server.
ISK_DOMAIN=isk.example.com
ACME_EMAIL=you@example.com
# Cloudflare API token scoped to Zone:DNS:Edit for the zone that owns
# ISK_DOMAIN. See deploy/README.md for how to create one.
CF_DNS_API_TOKEN=

# --- Postgres ---
POSTGRES_DB=iskworks
POSTGRES_USER=iskworks
POSTGRES_PASSWORD=

# --- EVE SSO ---
# Register an app at https://developers.eveonline.com with callback URL
# https://<ISK_DOMAIN>/api/eve/oauth/callback — shared by both login and
# character-linking (EVE's developer portal allows only one callback URL
# per app). See deploy/README.md.
#
# Authentication is MANDATORY for this stack: docker-compose.yml pins
# ISKWORKS_AUTH_REQUIRED=true, so the API will refuse to start if either of
# the two values below is missing or blank. Never run a public instance
# without them.
EVE_SSO_CLIENT_ID=
# 32 random bytes, base64-encoded. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- ESI contact ---
# How CCP can reach the operator of this instance: an email address (preferred),
# Discord handle, or EVE character name. Sent in the User-Agent of every ESI
# and SSO request, as CCP's ESI guidelines ask. Required.
ISKWORKS_ESI_CONTACT=

# --- Environment marker ---
# Set on non-production instances only (e.g. STAGE). The web app then shows
# a loud banner and prefixes the browser tab title. Leave blank on prod.
ISKWORKS_ENVIRONMENT_LABEL=

# --- Community links (optional) ---
# Shown in the footer, on About & Legal, and in Help. Leave blank to hide.
# ISKWORKS_SUPPORT_URL=https://discord.gg/your-invite
# ISKWORKS_SUPPORT_LABEL=Discord
# ISKWORKS_DONATION_CHARACTER=Your Character Name
# The "Source code" link defaults to the upstream repository. If you run a
# modified build, point it at your own source (AGPL-3.0, section 13).
# ISKWORKS_SOURCE_URL=https://github.com/you/your-fork

# --- Image tags ---
# Pin to a released version (e.g. v1.2.3) instead of "latest" for a
# reproducible, deliberate deploy.
ISKWORKS_API_TAG=latest
ISKWORKS_WORKER_TAG=latest
ISKWORKS_WEB_TAG=latest
ISKWORKS_SDE_IMPORT_TAG=latest
