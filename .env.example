DATABASE_URL=postgres://iskworks:iskworks@127.0.0.1:5432/iskworks
ISKWORKS_API_ADDR=127.0.0.1:8080

# EVE SSO is disabled unless EVE_SSO_CLIENT_ID is set.
EVE_SSO_CLIENT_ID=
EVE_SSO_REDIRECT_URI=http://127.0.0.1:8080/api/eve/oauth/callback
TOKEN_ENCRYPTION_KEY=
WEB_APP_URL=http://127.0.0.1:5173

# Fail-closed auth switch. Leave false/unset for local dev: the API may then
# run without EVE SSO in the legacy single-workspace mode. A public
# deployment MUST set this to true (see deploy/docker-compose.yml) so the
# API refuses to start if EVE SSO / token-encryption config is missing
# instead of silently serving one shared workspace unauthenticated.
ISKWORKS_AUTH_REQUIRED=false

# Comma-separated EVE character ids allowed into the in-app Admin section
# (needs real EVE SSO login; admin routes are closed when auth is off).
# ISKWORKS_ADMIN_CHARACTER_IDS=

# Explicit local fixture mode. Never enable this in production.
ISKWORKS_ESI_MOCK=0
ISKWORKS_WORKER_MARKET_POLL_SECONDS=5
ISKWORKS_WORKER_MARKET_FRESHNESS_SECONDS=900
ISKWORKS_WORKER_ADJUSTED_PRICE_POLL_SECONDS=30
ISKWORKS_WORKER_ADJUSTED_PRICE_FRESHNESS_SECONDS=21600
ISKWORKS_WORKER_SYSTEM_INDEX_POLL_SECONDS=30
ISKWORKS_WORKER_SYSTEM_INDEX_FRESHNESS_SECONDS=3600
ISKWORKS_WORKER_LEASE_SECONDS=120
ISKWORKS_WORKER_RETRY_SECONDS=60
ISKWORKS_API_ADDR=127.0.0.1:8080
VITE_API_BASE_URL=http://127.0.0.1:8080
